/**
 * A reusable composable that applies a HyperOS-style real-time blur to its background.
 * Works best on Android 12+ via RenderEffect.
 */
@Composable
fun GlassBlurBox(
    modifier: Modifier = Modifier,
    cornerRadius: Dp = 32.dp,
    blurRadius: Float = 25f,
    tintColor: Color = Color(0x33FFFFFF) // Semi-transparent white tint
) {
    Box(
        modifier = modifier
            .clip(RoundedCornerShape(cornerRadius))
            .graphicsLayer {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.S) {
                    // Apply a real-time blur to whatever is behind this layer
                    renderEffect = RenderEffect.createBlurEffect(
                        blurRadius,
                        blurRadius,
                        Shader.TileMode.CLAMP
                    ).asComposeRenderEffect()
                }
                // The tint gives it that "milky" glass look
                this.backgroundColor = tintColor
            }
            .background(Color.Transparent) // Ensure the tint is the only background
    ) {
        // Content goes here (Icons, Text, etc.)
    }
}

