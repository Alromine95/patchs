// iOS-like dark palette for inactive tiles
private val TileInactiveColor = Color(0xFF1C1C1E) 
private val TileActiveColor = Color(0xFF0A84FF) // iOS Blue

/**
 * The main iOS Control Center layout using GlassBlurBox.
 */
@Composable
fun IosControlCenterLayout(modifier: Modifier = Modifier) {
    LazyVerticalGrid(
        columns = GridCells.Fixed(4),
        modifier = modifier.fillMaxSize().padding(16.dp),
        horizontalArrangement = Arrangement.spacedBy(12.dp),
        verticalArrangement = Arrangement.spacedBy(12.dp)
    ) {
        // 1. Connectivity Block (2x2)
        item(span = { GridItemSpan(2) }) {
            GlassBlurBox(modifier = Modifier.aspectRatio(1f)) {
                ConnectivityCluster()
            }
        }
        // 2. Media Player Block (2x2)
        item(span = { GridItemSpan(2) }) {
            GlassBlurBox(modifier = Modifier.aspectRatio(1f)) {
                MediaBlock()
            }
        }

        // 3. Standard Toggles & Tall Sliders
        item(span = { GridItemSpan(1) }) {
            IosSquircleToggle(Icons.Default.Lock, "Orientation", isActive = true, activeColor = Color.LightGray)
        }
        item(span = { GridItemSpan(1) }) {
            IosSquircleToggle(Icons.Default.DoNotDisturb, "DND", isActive = false)
        }
        item(span = { GridItemSpan(1) }) {
            IosVerticalSlider(Icons.Default.BrightnessHigh, fillLevel = 0.6f)
        }
        item(span = { GridItemSpan(1) }) {
            IosVerticalSlider(Icons.Default.VolumeOff, fillLevel = 0.2f)
        }

        // 4. Wide Screen Timeout Pill (Spans 2 columns)
        item(span = { GridItemSpan(2) }) {
            WideTogglePill("1m", "Screen Timeout")
        }
        // Empty spacer to push the next row down correctly
        item(span = { GridItemSpan(2) }) { Spacer(Modifier) }

        // 5. Bottom 4-Column Icon Grid
        val bottomTiles = listOf(
            IosTileData(Icons.Default.Flashlight, "Flashlight"),
            IosTileData(Icons.Default.Timer, "Timer"),
            IosTileData(Icons.Default.Calculate, "Calculator"),
            IosTileData(Icons.Default.CameraAlt, "Camera"),
            IosTileData(Icons.Default.Contrast, "Dark Mode", isActive = true),
            IosTileData(Icons.Default.ScreenRotation, "Rotation"),
            IosTileData(Icons.Default.BatteryChargingFull, "Low Power"),
            IosTileData(Icons.Default.GraphicEq, "Voice Memos"),
            IosTileData(Icons.Default.Settings, "Settings"),
            IosTileData(Icons.Default.Brightness4, "Dark Mode", isActive = true, activeColor = Color.LightGray)
        )
        items(bottomTiles) { tile ->
            IosSquircleToggle(tile.icon, tile.label, tile.isActive, tile.activeColor)
        }
    }
}

// --- Sub-Composables for the Layout ---

@Composable
private fun ConnectivityCluster() {
    Column(Modifier.fillMaxSize().padding(16.dp), verticalArrangement = Arrangement.SpaceBetween) {
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
            IosCircleIcon(Icons.Default.AirplanemodeActive)
            IosCircleIcon(Icons.Default.CellTower)
        }
        Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
            IosCircleIcon(Icons.Default.Wifi, isActive = true)
            IosCircleIcon(Icons.Default.Bluetooth)
        }
    }
}

@Composable
private fun MediaBlock() {
    Column(
        Modifier.fillMaxSize().padding(16.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Text("Desconocido", color = Color.White, style = MaterialTheme.typography.titleMedium)
        Text("Desconocido", color = Color.Gray, style = MaterialTheme.typography.bodyMedium)
        Spacer(Modifier.height(16.dp))
        Row(
            Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceEvenly,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Icon(Icons.Default.SkipPrevious, "Prev", tint = Color.White)
            Icon(Icons.Default.PlayArrow, "Play", tint = Color.White, modifier = Modifier.size(48.dp))
            Icon(Icons.Default.SkipNext, "Next", tint = Color.White)
        }
    }
}

@Composable
private fun IosVerticalSlider(icon: ImageVector, fillLevel: Float) {
    GlassBlurBox(modifier = Modifier.aspectRatio(0.5f)) {
        // The filled portion (from the bottom)
        Box(
            Modifier.fillMaxWidth().fillMaxHeight(fillLevel).align(Alignment.BottomCenter).background(Color.White.copy(alpha = 0.8f))
        )
        Icon(
            icon, null, tint = if (fillLevel > 0.1f) Color.Black else Color.Gray,
            modifier = Modifier.size(32.dp).align(Alignment.BottomCenter).padding(bottom = 16.dp)
        )
    }
}

@Composable
private fun IosSquircleToggle(icon: ImageVector, label: String, isActive: Boolean = false, activeColor: Color = TileActiveColor) {
    GlassBlurBox(
        modifier = Modifier.aspectRatio(1f),
        cornerRadius = 24.dp,
        tintColor = if (isActive) activeColor else TileInactiveColor.copy(alpha = 0.6f)
    ) {
        Icon(icon, label, tint = if (isActive) Color.Black else Color.White, modifier = Modifier.size(32.dp).align(Alignment.Center))
    }
}

@Composable
private fun IosCircleIcon(icon: ImageVector, isActive: Boolean = false) {
    GlassBlurBox(
        modifier = Modifier.size(64.dp),
        cornerRadius = 32.dp, // Perfect circle
        tintColor = if (isActive) TileActiveColor else Color(0xFF2C2C2E).copy(alpha = 0.8f)
    ) {
        Icon(icon, null, tint = if (isActive) Color.White else Color.White, modifier = Modifier.size(28.dp).align(Alignment.Center))
    }
}

@Composable
private fun WideTogglePill(value: String, label: String) {
    GlassBlurBox(modifier = Modifier.fillMaxWidth().height(72.dp), cornerRadius = 36.dp) {
        Row(Modifier.fillMaxSize().padding(horizontal = 16.dp), verticalAlignment = Alignment.CenterVertically) {
            Box(Modifier.size(48.dp).clip(CircleShape).background(Color(0xFF3A3A3C)), contentAlignment = Alignment.Center) {
                Text(value, color = Color.White)
            }
            Spacer(Modifier.width(16.dp))
            Text(label, color = Color.White)
        }
    }
}

data class IosTileData(val icon: ImageVector, val label: String, val isActive: Boolean = false, val activeColor: Color = TileActiveColor)
